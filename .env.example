# ---------------------------------------------------------------------------
# Copia este fichero a `.env` y ajusta los valores.
#
#   cp .env.example .env
#
# Las variables marcadas como obligatorias impiden arrancar el compose si
# no están definidas.
# ---------------------------------------------------------------------------

# Registro y prefijo de imagen (Docker Hub o GitHub Packages ghcr.io)
# Ejemplos:
#   Docker Hub:  IMAGE_PREFIX=tu_usuario            (o DOCKERHUB_USERNAME=tu_usuario)
#   GitHub GHCR: IMAGE_PREFIX=ghcr.io/tu_usuario
IMAGE_PREFIX=opendrive
DOCKERHUB_USERNAME=tu_usuario_dockerhub
IMAGE_TAG=latest

# Puerto del frontend Web (por defecto 3000, o 80 si prefieres el puerto web estándar).
WEB_PORT=3000

# Puerto del backend (API REST + subidas tus + WebDAV).
BACKEND_PORT=8080

# URL de acceso de OpenDrive.
# Si accedes directamente por IP: http://192.168.0.XX:3000 (o la IP de tu portátil)
# Si accedes con dominio y TLS: https://drive.tudominio.com
OPENDRIVE_PUBLIC_URL=http://localhost:3000

# Dominio público y correo para TLS (solo si activas Caddy con: docker compose --profile tls up -d).
DOMAIN=drive.ejemplo.com
ACME_EMAIL=admin@ejemplo.com

# Token de Cloudflare Tunnel (opcional, solo si usas `docker compose --profile tunnel up -d`).
# CLOUDFLARE_TUNNEL_TOKEN=eyJh...

# Credenciales de la base de datos. Son obligatorias.
POSTGRES_USER=opendrive
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=opendrive

# Administrador que se crea en el primer arranque. También es obligatoria.
ADMIN_EMAIL=admin@opendrive.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena

# Duración de la sesión en horas.
SESSION_TTL_HOURS=24

# Tamaño máximo por archivo en bytes. 0 = sin límite.
MAX_UPLOAD_SIZE=0

# Horas hasta que se considera abandonado un upload en curso.
TUS_EXPIRY_HOURS=24

# Cuota por usuario en bytes. 0 = sin cuota.
DEFAULT_QUOTA_BYTES=0

# Permite el registro público de usuarios.
ALLOW_REGISTRATION=false

# Nivel de log del backend: error, warn, info, debug, trace.
RUST_LOG=info
