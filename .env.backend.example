# ---------------------------------------------------------------------------
# OpenDrive — Configuración para servidor SOLO BACKEND
#
# Copia este archivo a `.env`:
#   cp .env.backend.example .env
# ---------------------------------------------------------------------------

# Registro y prefijo de imagen (Docker Hub o GitHub Packages ghcr.io)
# Ejemplos:
#   Docker Hub:  IMAGE_PREFIX=tu_usuario            (o DOCKERHUB_USERNAME=tu_usuario)
#   GitHub GHCR: IMAGE_PREFIX=ghcr.io/tu_usuario
IMAGE_PREFIX=opendrive
DOCKERHUB_USERNAME=tu_usuario_dockerhub
IMAGE_TAG=latest

# Puerto de escucha del backend (API REST + WebDAV RFC 4918 + tus uploads)
BACKEND_PORT=8080

# URL pública o IP con la que accederás a la API
# Ejemplos: http://192.168.0.20:8080, http://tu-vps-ip:8080 o https://api.tudominio.com
OPENDRIVE_PUBLIC_URL=http://localhost:8080

# Credenciales de la base de datos PostgreSQL (Obligatorias)
POSTGRES_USER=opendrive
POSTGRES_PASSWORD=cambia-esta-contrasena-segura
POSTGRES_DB=opendrive

# Administrador que se crea en el primer arranque (Obligatorio)
ADMIN_EMAIL=admin@opendrive.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena-admin

# Parámetros del servidor
SESSION_TTL_HOURS=24
MAX_UPLOAD_SIZE=0          # 0 = sin límite de tamaño de archivo
TUS_EXPIRY_HOURS=24        # Tiempo de retención de uploads incompletos
DEFAULT_QUOTA_BYTES=0      # 0 = sin límite de cuota por usuario
ALLOW_REGISTRATION=false   # Registro público de usuarios
RUST_LOG=info              # Nivel de log: error, warn, info, debug, trace
